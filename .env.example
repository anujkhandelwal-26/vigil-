# ---------------------------------------------------------------------------
# VIGIL — environment configuration template.
# Copy to .env and fill in real values. .env is gitignored and never committed.
# Nothing here has a real secret. See SECURITY notes in README.md.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_DB=vigil
POSTGRES_USER=vigil
POSTGRES_PASSWORD=changeme_generate_a_real_secret
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vigil:changeme_generate_a_real_secret@localhost:5433/vigil

# --- decision-api (Spring Boot) ---
SERVER_PORT=8081
VIGIL_JWT_SECRET=changeme_generate_a_256bit_secret_do_not_reuse
VIGIL_JWT_TTL_MINUTES=60
VIGIL_ML_SERVICE_URL=http://localhost:8001
VIGIL_ML_TIMEOUT_MS=150
VIGIL_DEMO_PASSWORD=changeme_local_demo_only

# --- ml-service (FastAPI) ---
ML_SERVICE_PORT=8001
MODEL_DIR=./artifacts

# --- LLM / embeddings provider (swap by changing these two lines only) ---
# one of: ollama | bedrock | anthropic | openai | mock
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ollama (default, local, free)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# aws bedrock (optional alternative — set LLM_PROVIDER=bedrock to use)
AWS_REGION=ap-south-1
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS credentials are read from the standard AWS credential chain (env / profile / instance role).
# Never hardcode AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file or in code.

# anthropic (optional alternative — set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=

# --- frontend (web) ---
VITE_API_BASE_URL=/api
